# Database
MONGODB_URI=mongodb://127.0.0.1:27017/placepilot

# Authentication
JWT_ACCESS_SECRET=replace_with_a_long_random_string_for_access_token
JWT_REFRESH_SECRET=replace_with_a_long_random_string_for_refresh_token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (for file/resume uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Emails (Resend)
RESEND_API_KEY=

# Google Gemini AI API
GEMINI_API_KEY=

# App Settings
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
